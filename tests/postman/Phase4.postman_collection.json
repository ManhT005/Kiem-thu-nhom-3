    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"phase2-admin@example.test\",\"password\":\"Phase2Test!\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('voucherCode','P4-'+Date.now());",
              "pm.collectionVariables.set('voucherStart',new Date(Date.now()-60000).toISOString());",
              "pm.collectionVariables.set('voucherEnd',new Date(Date.now()+86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "User cannot create voucher",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/vouchers",
        "header": [

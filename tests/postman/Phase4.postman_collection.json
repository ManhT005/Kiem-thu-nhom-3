    {
      "name": "Create FIXED voucher",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/vouchers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\":\"{{voucherCode}}\",\"discountType\":\"FIXED\",\"discountValue\":500,\"minimumOrderAmount\":0,\"startAt\":\"{{voucherStart}}\",\"endAt\":\"{{voucherEnd}}\",\"usageLimit\":1,\"perUserLimit\":1,\"enabled\":true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('voucherId',pm.response.json().data.maGiamGia);"
            ]
          }
        }
      ]
    },
    {
      "name": "Preview uses server price and consumes nothing",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/vouchers/validate",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"voucherCode\":\"{{voucherCode}}\",\"subtotal\":1,\"items\":[{\"maSP\":93003,\"maSize\":92901,\"soLuongMua\":1,\"gia\":1}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Server preview',()=>{const d=pm.response.json().data;pm.expect(d.subtotalBeforeDiscount).to.eql(3000);pm.expect(d.discountAmount).to.eql(500);pm.expect(d.totalAfterDiscount).to.eql(2500);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Usage remains zero after preview",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/vouchers?code={{voucherCode}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('No consumption',()=>pm.expect(pm.response.json().data.items[0].used_count).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create voucher order ignores fake prices",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders/create",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tenNguoiNhan\":\"Phase4 QA\",\"sdt\":\"0900000000\",\"diaChiGiaoHang\":\"QA address\",\"maPTTT\":92901,\"voucherCode\":\"{{voucherCode}}\",\"idempotencyKey\":\"p4-{{voucherCode}}\",\"tongTien\":1,\"discountAmount\":999999,\"items\":[{\"maSP\":93003,\"maSize\":92901,\"soLuongMua\":1,\"gia\":1}]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json().data;pm.collectionVariables.set('orderId',d.maDonHang);pm.test('Snapshot',()=>{pm.expect(d.tongTien).to.eql(2500);pm.expect(d.discountAmount).to.eql(500);pm.expect(d.subtotalBeforeDiscount).to.eql(3000);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Idempotent voucher order replay",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders/create",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"

    {
      "name": "P5-R-001/002/003/004/010 summary oracle",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/dashboard/summary?from=2091-01-01&to=2091-01-05"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Envelope and code\", () => { pm.expect(body.success).to.eql(true); pm.expect(body.code).to.be.a(\"string\"); });",
              "pm.test(\"Exact completion oracle\", () => { pm.expect(body.code).to.eql(\"DASHBOARD_SUMMARY_FETCHED\"); pm.expect(body.data.completedOrderCount).to.eql(2); pm.expect(body.data.completedOrderValue).to.eql(7000); pm.expect(body.data.grossCompletedValue).to.eql(7500); pm.expect(body.data.completedDiscountAmount).to.eql(500); pm.expect(body.data.totalOrders).to.eql(10); pm.expect(body.data.legacyExcluded).to.be.at.least(2); });"
            ]
          }
        }
      ]
    },

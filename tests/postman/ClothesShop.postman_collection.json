  "item": [
    {
      "name": "Health is up",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('SUCCESS contract', () => pm.expect(pm.response.json().code).to.eql('SUCCESS'));"
            ]
          }
        }
      ]
    },

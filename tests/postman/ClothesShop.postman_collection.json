    {
      "name": "Register rejects short password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ten\": \"Smoke User\",\n  \"email\": \"invalid-email\",\n  \"matKhau\": \"short\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [

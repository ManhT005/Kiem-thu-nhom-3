        {
          "name": "Cancellation restores inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/93004"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().data.product;",
                  "pm.test('stock restored once', () => pm.expect(product.sizes.find((size) => size.maSize === 92901).soLuongTon).to.eql(10));"
                ]
              }
            }
          ]
        },

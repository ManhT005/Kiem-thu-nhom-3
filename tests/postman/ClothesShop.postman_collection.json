        {
          "name": "Create order ignores client prices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenNguoiNhan\": \"Phase 2 Recipient\",\n  \"sdt\": \"0900000000\",\n  \"diaChiGiaoHang\": \"Test address\",\n  \"maPTTT\": 92901,\n  \"tongTien\": 1,\n  \"items\": [{ \"maSP\": 93004, \"maSize\": 92901, \"soLuongMua\": 1, \"gia\": 1 }]\n}"
            },
            "url": "{{baseUrl}}/api/orders/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json().data;",
                  "pm.test('server price and pending status', () => { pm.expect(order.tongTien).to.eql(4000); pm.expect(order.trangThai).to.eql('Chờ xác nhận'); });",
                  "pm.collectionVariables.set('phase2OrderId', order.maDonHang);"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff cannot create an order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/orders/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
